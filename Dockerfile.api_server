# Docker Hardened Images (Alpine)
#   build:   '-dev' variant, has a shell + apk for compiling packages
#   runtime: no shell or package manager, so everything is staged in the build image
#            and copied across (no RUN steps are possible in the final stage)
ARG PYTHON_BUILD_IMAGE=dhi.io/python:3-alpine-dev
ARG PYTHON_RUNTIME_IMAGE=dhi.io/python:3-alpine

FROM ${PYTHON_RUNTIME_IMAGE} AS runtime-base

# ---- STAGE 1 -----
FROM ${PYTHON_BUILD_IMAGE} AS build-packages

ENV PIP_BREAK_SYSTEM_PACKAGES=1
# llvm22 is needed to compile llvmlite (numba), no musllinux wheels are published
RUN apk add --no-cache gcc g++ make cmake musl-dev linux-headers pkgconf python3-dev mariadb-connector-c-dev \
    llvm22-dev llvm22-static llvm22-gtest zlib-dev zstd-dev libxml2-dev \
    bash curl mariadb-connector-c musl-utils
ENV CMAKE_PREFIX_PATH=/usr/lib/llvm22

COPY ./requirements-server.txt ./requirements-server.txt
RUN pip install --user --no-warn-script-location -r ./requirements-server.txt && pip install --no-warn-script-location --user mysqlclient

# Install ODS-Tools from git branch (Optional) 'docker build --build-arg ods_tools_branch=develop'
ARG ods_tools_branch
RUN if [ ! -z "$ods_tools_branch" ] ; then \
    apk add --no-cache git; \
    pip uninstall ods-tools -y; \
    pip install --user --no-warn-script-location -v git+https://git@github.com/OasisLMF/ODS_Tools.git@${ods_tools_branch}#egg=ods-tools; \
  fi

# Install Oasis-Data-Manager from git branch (Optional) 'docker build --build-arg odm_branch=develop'
ARG odm_branch
RUN if [ ! -z "$odm_branch" ] ; then \
    apk add --no-cache git; \
    pip uninstall oasis-data-manager -y; \
    pip install --user --no-warn-script-location -v git+https://git@github.com/OasisLMF/OasisDataManager.git@${odm_branch}#egg=oasis-data-manager; \
  fi

# Slim down site-packages: drop bundled test suites (scipy/numpy/etc) and strip debug symbols
# from compiled libs (llvmlite is built from source with debug info)
RUN find /root/.local -type d -name tests -prune -exec rm -rf {} + \
 && find /root/.local -name '*.so*' -type f -exec strip --strip-unneeded {} +

# Stage the runtime filesystem in /rootfs
#  - bash (startup scripts), curl (wait-for-server) and a minimal set of busybox applets
#  - any shared libs needed by the above + compiled python packages, which are missing from the runtime image
COPY --from=runtime-base / /runtime-base
RUN mkdir -p /rootfs/bin /rootfs/usr/bin \
 && cp /bin/bash /bin/busybox /rootfs/bin/ \
 && cp /usr/bin/curl /rootfs/usr/bin/ \
 && for app in sh cat chmod cp env find grep ls mkdir mv rm sed sleep timeout; do ln -s /bin/busybox /rootfs/bin/$app; done \
 && ln -s /bin/busybox /rootfs/usr/bin/env \
 && { find /root/.local -name '*.so*' -type f; echo /bin/bash; echo /bin/busybox; echo /usr/bin/curl; } \
    | xargs -r ldd 2>/dev/null | awk '$2 == "=>" && $3 ~ /^\// {print $3}' | sort -u \
    | while read lib; do \
        [ -e "/runtime-base$lib" ] && continue; \
        case "$lib" in /root/.local/*) continue ;; esac; \
        mkdir -p "/rootfs$(dirname $lib)" && cp -L "$lib" "/rootfs$lib"; \
      done \
 && rm -rf /runtime-base

ARG USER_ID=1000
RUN adduser -D -u ${USER_ID} -h /home/server -s /bin/bash server \
 && mkdir -p /rootfs/etc /rootfs/var/log/oasis /rootfs/shared-fs \
 && chmod 777 /rootfs/var/log/oasis \
 && cp /etc/passwd /etc/group /rootfs/etc/

WORKDIR /var/www/oasis
COPY ./requirements-server.txt ./requirements.txt
COPY ./src/model_execution_worker/ ./src/model_execution_worker/
COPY ./asgi ./asgi
COPY ./wsgi ./wsgi
COPY ./conf.ini ./
COPY manage.py .
COPY ./src/utils/set_default_user.py .
COPY ./src/server ./src/server
COPY ./src/common ./src/common
COPY ./src/conf ./src/conf
COPY ./VERSION ./VERSION
RUN chmod +x ./asgi/run-asgi.sh ./wsgi/run-wsgi.sh \
 && OASIS_API_SECRET_KEY=supersecret python3 manage.py collectstatic --noinput

COPY --chmod=755 ./src/startup_server.sh /rootfs/usr/local/bin/startup
COPY --chmod=755 ./src/utils/wait-for-it.sh /rootfs/usr/local/bin/wait-for-it
COPY --chmod=755 ./src/utils/wait-for-server.sh /rootfs/usr/local/bin/wait-for-server
COPY --chmod=755 ./src/utils/plat2-migration-helper.sh /rootfs/usr/local/bin/migration-helper.sh

# ---- STAGE 2 ----
FROM runtime-base

COPY --from=build-packages /rootfs /
COPY --chown=server:server --from=build-packages /root/.local /home/server/.local
COPY --chown=server:server --from=build-packages /var/www/oasis /var/www/oasis
COPY --chown=server:server --from=build-packages /rootfs/shared-fs /shared-fs
COPY --chown=server:server ./src/utils/server_bashrc /home/server/.bashrc

WORKDIR /var/www/oasis
USER server
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV OASIS_SERVER_DB_ENGINE=django.db.backends.mysql
ENV OASIS_MEDIA_ROOT=/shared-fs
ENV OASIS_DEBUG=false
ENV PATH=/home/server/.local/bin:$PATH

EXPOSE 8000
EXPOSE 8001
EXPOSE 51970

ENTRYPOINT ["startup"]
CMD ["./wsgi/run-wsgi.sh"]
