# Docker Hardened Images (Alpine)
#   build:   '-dev' variant, has a shell + apk for compiling packages
#   runtime: no shell or package manager, so everything is staged in /rootfs in the build image
#            and copied across (no RUN steps are possible in the final stage). Nothing is added
#            to the runtime image's system packages: the entrypoint / run scripts are python and
#            MySQL uses the pure python PyMySQL driver.
ARG PYTHON_BUILD_IMAGE=dhi.io/python:3-alpine-dev
ARG PYTHON_RUNTIME_IMAGE=dhi.io/python:3-alpine

# ---- STAGE 1 -----
FROM ${PYTHON_BUILD_IMAGE} AS build-packages

ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN apk add --no-cache gcc g++ make musl-dev linux-headers python3-dev git

COPY ./requirements-server.txt ./requirements-server.txt
RUN pip install --user --no-warn-script-location -r ./requirements-server.txt

# Install ODS-Tools from git branch (Optional) 'docker build --build-arg ods_tools_branch=develop'
ARG ods_tools_branch
RUN if [ ! -z "$ods_tools_branch" ] ; then \
    apk add --no-cache git; \
    pip uninstall ods-tools -y; \
    pip install --user --no-warn-script-location -v "ods-tools @ git+https://git@github.com/OasisLMF/ODS_Tools.git@${ods_tools_branch}"; \
  fi

# Install Oasis-Data-Manager from git branch (Optional) 'docker build --build-arg odm_branch=develop'
ARG odm_branch
RUN if [ ! -z "$odm_branch" ] ; then \
    apk add --no-cache git; \
    pip uninstall oasis-data-manager -y; \
    pip install --user --no-warn-script-location -v "oasis-data-manager @ git+https://git@github.com/OasisLMF/OasisDataManager.git@${odm_branch}"; \
  fi

# Slim down site-packages: drop bundled test suites (scipy/numpy/etc) and strip debug symbols
# from compiled libs
RUN find /root/.local -type d -name tests -prune -exec rm -rf {} + \
 && find /root/.local -type f \( -name '*.so' -o -name '*.so.[0-9]*' \) -exec strip --strip-unneeded {} +

# OpenShift support: the user's primary group is root (0), runtime files are owned by ${USER_ID}:0
# with group permissions matching the user's, so the image also runs under a random assigned UID
ARG USER_ID=1000
RUN adduser -D -u ${USER_ID} -G root -h /home/server -s /sbin/nologin server \
 && mkdir -p /rootfs/etc \
 && cp /etc/passwd /etc/group /rootfs/etc/

WORKDIR /var/www/oasis
COPY ./requirements-server.txt ./requirements.txt
COPY ./src/model_execution_worker/ ./src/model_execution_worker/
COPY ./asgi ./asgi
COPY ./wsgi ./wsgi
COPY ./conf.ini ./
COPY manage.py .
COPY ./src/utils/set_default_user.py .
COPY ./src/server ./src/server
COPY ./src/common ./src/common
COPY ./src/conf ./src/conf
COPY ./VERSION ./VERSION
RUN chmod +x ./asgi/run-asgi.sh ./wsgi/run-wsgi.sh \
 && OASIS_API_SECRET_KEY=supersecret python3 manage.py collectstatic --noinput

COPY --chmod=755 ./src/startup_server.py /rootfs/usr/local/bin/startup

# Stage the writable paths into /rootfs owned by ${USER_ID}:0 with group perms = user perms (g=u).
# They're copied as part of /rootfs (not as COPY destinations) so the ownership and modes are kept.
RUN mkdir -p /rootfs/home/server /rootfs/var/www /rootfs/var/log/oasis /rootfs/shared-fs \
 && mv /root/.local /rootfs/home/server/.local \
 && cp -a /var/www/oasis /rootfs/var/www/oasis \
 && chown -R ${USER_ID}:0 /rootfs/home/server /rootfs/var/www/oasis /rootfs/var/log/oasis /rootfs/shared-fs \
 && chmod -R g=u /rootfs/home/server /rootfs/var/www/oasis /rootfs/var/log/oasis /rootfs/shared-fs \
 && chmod 775 /rootfs/home/server /rootfs/shared-fs \
 && chmod 777 /rootfs/var/log/oasis \
 && chmod 755 /rootfs /rootfs/home /rootfs/var /rootfs/var/www /rootfs/var/log

# ---- STAGE 2a: dev flavour ----
# '-dev' base with a shell + apk for debugging, build with: docker build --target server-dev
FROM ${PYTHON_BUILD_IMAGE} AS server-dev

COPY --from=build-packages /rootfs /
RUN apk add --no-cache bash busybox curl mariadb-connector-c
# The dev image uses the original bash startup scripts (overriding the python 'startup' from /rootfs)
COPY --chmod=755 ./src/startup_server.sh /usr/local/bin/startup
COPY --chmod=755 ./src/utils/wait-for-it.sh /usr/local/bin/wait-for-it
COPY --chmod=755 ./src/utils/plat2-migration-helper.sh /usr/local/bin/migration-helper.sh
COPY --chown=1000:0 ./src/utils/server_bashrc /home/server/.bashrc

WORKDIR /var/www/oasis
USER 1000
ENV HOME=/home/server
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV OASIS_SERVER_DB_ENGINE=django.db.backends.mysql
ENV OASIS_MEDIA_ROOT=/shared-fs
ENV OASIS_DEBUG=false
ENV PATH=/home/server/.local/bin:$PATH

EXPOSE 8000
EXPOSE 8001
EXPOSE 51970

ENTRYPOINT ["startup"]
CMD ["./wsgi/run-wsgi.sh"]


# ---- STAGE 2b: hardened flavour (default, must stay the last stage) ----
# Runtime base, no shell or package manager
FROM ${PYTHON_RUNTIME_IMAGE} AS server

COPY --from=build-packages /rootfs /

WORKDIR /var/www/oasis
USER 1000
ENV HOME=/home/server
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV OASIS_SERVER_DB_ENGINE=django.db.backends.mysql
ENV OASIS_MEDIA_ROOT=/shared-fs
ENV OASIS_DEBUG=false
ENV PATH=/home/server/.local/bin:$PATH

EXPOSE 8000
EXPOSE 8001
EXPOSE 51970

ENTRYPOINT ["startup"]
CMD ["./wsgi/run-wsgi.sh"]
